{
  "name": "romantic-calc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "start": "vite --open",
    "hardstart": "vite --open --force",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
